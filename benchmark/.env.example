# ==============================================================================
# openfal vs ComfyUI vs vLLM-Omni — Benchmark & RunPod Configuration
# Copy to `benchmark/.env` (`cp benchmark/.env.example benchmark/.env`) and fill
# in `RUNPOD_API_KEY` (and optional `HF_TOKEN`) before running RunPod provisioning.
# ==============================================================================

# --- RunPod Provisioning (benchmark/runpod_provision.py) ---
RUNPOD_API_KEY=
RUNPOD_POD_NAME=openfal-bench
# Common GPUs for apples-to-apples comparisons:
#   NVIDIA GeForce RTX 5090   (32 GB GDDR7 — offload test for 33B/14B models)
#   NVIDIA GeForce RTX 4090   (24 GB GDDR6X — heavy PCIe offload stress test)
#   NVIDIA L40S               (48 GB GDDR6  — mid VRAM)
#   NVIDIA A100-SXM4-80GB     (80 GB HBM2e — resident-in-VRAM kernel speed test)
#   NVIDIA H100 80GB HBM3     (80 GB HBM3  — flagship resident FP8/BF16 test)
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 5090"
RUNPOD_GPU_COUNT=1
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_CONTAINER_DISK_GB=120
RUNPOD_VOLUME_GB=220
# CUDA 12.8 base image works cleanly for RTX 5090 (Blackwell sm_120) + 4090/A100/H100
RUNPOD_IMAGE="runpod/pytorch:2.8.0-py3.12-cuda12.8.1-devel-ubuntu2204"
# Optional public key path injected into the pod; auto-discovers ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub if blank
RUNPOD_SSH_PUBKEY_PATH=

# --- Git Source & Hugging Face ---
OPENFAL_REPO_URL="https://github.com/esokullu/openfal.git"
OPENFAL_BRANCH="main"
HF_TOKEN=

# --- Workspace Paths on the GPU Machine / Pod ---
BENCH_WORKSPACE="/workspace/openfal_bench"
OPENFAL_WEIGHTS_DIR="/workspace/openfal_bench/weights/MiniMax-H3"
COMFYUI_DIR="/workspace/openfal_bench/ComfyUI"
HF_HOME="/workspace/openfal_bench/hf_cache"

# --- Installed Model Bundle & Engine Tuning ---
# Bundles: all | minimax-only | alibaba-only | qwen_image_21
OPENFAL_DOWNLOAD_BUNDLE="all"
OPENFAL_PROFILE="auto"

# Optional extra CLI flags for fair "tuned vs default" sweeps:
# Example ComfyUI: "--highvram" or "--lowvram" or ""
COMFYUI_EXTRA_ARGS=""
# vLLM-Omni offload toggle: set "true" on 24GB/32GB GPUs for 14B/33B models, "false" on 80GB A100/H100
VLLM_OMNI_OFFLOAD="true"
VLLM_OMNI_EXTRA_ARGS=""

# --- Engine Endpoints (used when benchmarking running services without --sequential-local) ---
OPENFAL_URL="http://127.0.0.1:8000"
COMFYUI_URL="http://127.0.0.1:8188"
VLLM_OMNI_URL="http://127.0.0.1:8091"

# --- Benchmark Runner Defaults (benchmark/bench_runner.py) ---
BENCH_TARGETS="openfal,comfyui,vllm_omni"
BENCH_SCENARIOS="qwen21_t2i,wan22_t2v_14b,minimax_h3_t2v,minimax_h3_t2i"
BENCH_WARMUP=1
BENCH_REPEATS=3
# Comma-separated concurrency levels, e.g. "1,4" to compare openfal lock serialization vs batching
BENCH_CONCURRENCY="1"
BENCH_SEED=42
BENCH_OUTPUT_DIR="benchmark/results"
